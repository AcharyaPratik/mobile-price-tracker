# Copy to .env and fill in your values
#   cp .env.example .env

# UID to run Airflow as — set to your host user's UID so bind-mounted
# files (dags, logs, plugins) aren't owned by root after container writes.
#   On Linux / WSL2:  run `id -u` and paste the number
#   On macOS / Windows:  leave as 50000 (Docker Desktop handles mapping)
AIRFLOW_UID=50000

DB_HOST=localhost
DB_PORT=5433
DB_NAME=mobile_tracker
DB_USER=postgres
DB_PASSWORD=devpass